# Copy to .env and fill in values. Never commit .env.

# Hugging Face read token (embeddings)
# https://huggingface.co/settings/tokens
HF_TOKEN=

# LLM provider: ollama (local) | gemini | groq | openai | grok
# Local default is ollama.
# Docker / production default is gemini (see Dockerfile ENV LLM_PROVIDER=gemini).
LLM_PROVIDER=ollama

# Optional override of the default model for the selected provider
# Local Ollama default: qwen2.5:7b-instruct-q8_0
# Gemini deploy default: gemini-2.0-flash
# LLM_MODEL=gemini-2.0-flash

# Cloud API keys (set the one matching LLM_PROVIDER; LLM_API_KEY works as a fallback)
# Required for deploy with Gemini:
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# LLM_API_KEY=

# Optional OpenAI-compatible base URL override
# LLM_BASE_URL=

# Production CORS allowlist (comma-separated). Use * only for local/dev.
# CORS_ORIGINS=https://racecoe.example.com

# Bind address/port for server.py / Docker
# HOST=0.0.0.0
# PORT=8000

# Optional: preload FAISS indexes at startup (comma-separated categories).
# Example: historical,sporting,financial
# RAG_WARMUP_CATEGORIES=

# Set to 1 in unit tests to skip RAG warmup
# F1_SKIP_WARMUP=
